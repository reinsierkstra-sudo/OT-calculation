<?xml version="1.0" encoding="UTF-16"?>
<Tasks>

  <!-- Task 1: Run harvest at logon and every 4 hours -->
  <Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
    <RegistrationInfo>
      <Description>LaptopHours — harvest Event Log data</Description>
      <URI>\LaptopHours\Harvest</URI>
    </RegistrationInfo>
    <Triggers>
      <LogonTrigger>
        <Enabled>true</Enabled>
      </LogonTrigger>
      <TimeTrigger>
        <Repetition>
          <Interval>PT4H</Interval>
          <StopAtDurationEnd>false</StopAtDurationEnd>
        </Repetition>
        <StartBoundary>2024-01-01T08:00:00</StartBoundary>
        <Enabled>true</Enabled>
      </TimeTrigger>
    </Triggers>
    <Principals>
      <Principal id="Author">
        <LogonType>InteractiveToken</LogonType>
        <RunLevel>LeastPrivilege</RunLevel>
      </Principal>
    </Principals>
    <Settings>
      <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
      <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
      <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
      <Hidden>true</Hidden>
      <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
    </Settings>
    <Actions>
      <Exec>
        <Command>powershell.exe</Command>
        <Arguments>-NonInteractive -WindowStyle Hidden -File "C:\Users\%USERNAME%\LaptopHours\scripts\run_harvest.ps1"</Arguments>
        <WorkingDirectory>C:\Users\%USERNAME%\LaptopHours</WorkingDirectory>
      </Exec>
    </Actions>
  </Task>

  <!-- Task 2: Start dashboard at logon -->
  <Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
    <RegistrationInfo>
      <Description>LaptopHours — start dashboard server</Description>
      <URI>\LaptopHours\Dashboard</URI>
    </RegistrationInfo>
    <Triggers>
      <LogonTrigger>
        <Delay>PT10S</Delay>
        <Enabled>true</Enabled>
      </LogonTrigger>
    </Triggers>
    <Principals>
      <Principal id="Author">
        <LogonType>InteractiveToken</LogonType>
        <RunLevel>LeastPrivilege</RunLevel>
      </Principal>
    </Principals>
    <Settings>
      <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
      <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
      <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
      <Hidden>true</Hidden>
      <ExecutionTimeLimit>PT1M</ExecutionTimeLimit>
    </Settings>
    <Actions>
      <Exec>
        <Command>powershell.exe</Command>
        <Arguments>-NonInteractive -WindowStyle Hidden -File "C:\Users\%USERNAME%\LaptopHours\scripts\start_dashboard.ps1"</Arguments>
        <WorkingDirectory>C:\Users\%USERNAME%\LaptopHours</WorkingDirectory>
      </Exec>
    </Actions>
  </Task>

</Tasks>
